---
import "../styles/global.css";
import { HeroSection } from "@/components/views/home/heroSection";
import { WhySection } from "@/components/views/home/whySection";
import { ServicesSection } from "@/components/views/home/servicesSection";
import { ProcessSection } from "@/components/views/home/processSection";
import { WorkshopSection } from "@/components/views/home/workshopSection";
import { TestimonialsSection } from "@/components/views/home/testimonialsSection";
import MainLayout from "@/layouts/mainLayout.astro";
import { BrandsCarousel } from "@/components/views/home/brandsCarousel";
import { ContactSection } from "@/components/contactSection";
import { fetchHomePage } from "@/lib/sanity";

let homeData;
let error = null;

try {
  homeData = await fetchHomePage();
} catch (e) {
  console.error('Error fetching home page data:', e);
  error = e;
  // Se usarán los fallbacks de cada componente
  homeData = null;
}

const pageTitle = homeData?.seo?.metaTitle || "Mecánica Carrión - Inicio";
const pageDescription = homeData?.seo?.metaDescription || "Especialistas en motocicletas desde hace tres generaciones. Mantenimiento, restauración y modificaciones con pasión y experiencia.";
---
<MainLayout title={pageTitle} description={pageDescription}>
  <HeroSection data={homeData} />
  <WhySection data={homeData} />
  <ServicesSection data={homeData} />
  <ProcessSection data={homeData} />
  <WorkshopSection data={homeData} />
  <TestimonialsSection client:load />
  <BrandsCarousel client:load />
  <ContactSection />
</MainLayout>
