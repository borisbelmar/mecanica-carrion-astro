---
import MainLayout from "../layouts/mainLayout.astro"
import ServicesView from "../components/views/services"
import { ContactSection } from "@/components/contactSection";
import { fetchServicesPage } from "@/lib/sanity";

const servicesData = await fetchServicesPage();
---

<MainLayout title={servicesData.seo?.metaTitle} description={servicesData.seo?.metaDescription}>
  <ServicesView servicesData={servicesData} client:load />
  <ContactSection />
</MainLayout>